@model RegisterAdminVM

@{
	ViewData["Title"] = "Register New Admin";
}

<div class="container py-4">
	<h2 class="mb-4">
		<i class="bi bi-person-plus"></i> Register New Admin
	</h2>

	<form asp-area="Admin" asp-controller="Admin" asp-action="RegisterAdmin"
		  method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
		@Html.AntiForgeryToken()
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<input asp-for="SearchString" type="hidden" />
		<input asp-for="LockoutStatus" type="hidden" />
		<input asp-for="CurrentSort" type="hidden" />
		<input asp-for="CurrentPage" type="hidden" />

		<div class="mb-3">
			<label asp-for="Admin.FullName" class="form-label">
				<i class="bi bi-person"></i> Full Name
			</label>
			<input asp-for="Admin.FullName" class="form-control" />
			<span asp-validation-for="Admin.FullName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Email" class="form-label">
				<i class="bi bi-envelope"></i> Email
			</label>
			<input asp-for="Email" class="form-control" />
			<span asp-validation-for="Email" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Admin.PhoneNumber" class="form-label">
				<i class="bi bi-telephone"></i> Phone Number
			</label>
			<input asp-for="Admin.PhoneNumber" class="form-control" />
			<span asp-validation-for="Admin.PhoneNumber" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Admin.Address" class="form-label">
				<i class="bi bi-geo-alt"></i> Address
			</label>
			<input asp-for="Admin.Address" class="form-control" />
			<span asp-validation-for="Admin.Address" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Admin.Gender" class="form-label">
				<i class="bi bi-gender-ambiguous"></i> Gender
			</label>
			<select asp-for="Admin.Gender" asp-items="Model.GenderList" class="form-select">
				<option value="">-- Select Gender --</option>
			</select>
			<span asp-validation-for="Admin.Gender" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Admin.DateOfBirth" class="form-label">
				<i class="bi bi-calendar"></i> Date of Birth
			</label>
			<input asp-for="Admin.DateOfBirth" type="date" class="form-control" />
			<span asp-validation-for="Admin.DateOfBirth" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Admin.ImageFile" class="form-label">
				<i class="bi bi-image"></i> Profile Image (Optional)
			</label>
			<input asp-for="Admin.ImageFile" type="file" class="form-control"
				   accept="image/*" />
			<span asp-validation-for="Admin.ImageFile" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Password" class="form-label">
				<i class="bi bi-lock"></i> Password
			</label>
			<input asp-for="Password" class="form-control" />
			<span asp-validation-for="Password" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="ConfirmPassword" class="form-label">
				<i class="bi bi-lock-fill"></i> Confirm Password
			</label>
			<input asp-for="ConfirmPassword" class="form-control" />
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-between mt-4">
			<button type="submit" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Register
			</button>
			<a asp-area="Admin" asp-controller="Admin" asp-action="GetAllAdmins"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-lockoutStatus="@Model.LockoutStatus"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-secondary">
				<i class="bi bi-arrow-left-circle"></i> Back to List
			</a>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
