@model ResetPasswordVM

@{
    ViewData["Title"] = "Reset Admin Password";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-key"></i> Reset Admin Password</h2>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5><i class="bi bi-shield-lock"></i> Reset Password for @Model.AppUserEmail</h5>
        </div>

        <div class="card-body">
            <form asp-area="Admin" asp-controller="Admin" asp-action="ResetAdminPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="Id" type="hidden" />
				<input asp-for="AppUserEmail" type="hidden" />
                <input asp-for="SourceView" type="hidden" />
                <input asp-for="SearchString" type="hidden" />
                <input asp-for="LockoutStatus" type="hidden" />
                <input asp-for="CurrentSort" type="hidden" />
                <input asp-for="CurrentPage" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">
                        <i class="bi bi-key-fill"></i> New Password
                    </label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="bi bi-check2-circle"></i> Confirm New Password
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="bi bi-key"></i> Reset Password
                    </button>
                    <a asp-area="Admin" asp-controller="Admin" asp-action="@Model.SourceView"
                       asp-route-id="@Model.Id"
                       asp-route-searchString="@Model.SearchString"
                       asp-route-lockoutStatus="@Model.LockoutStatus"
                       asp-route-currentSort="@Model.CurrentSort"
                       asp-route-currentPage="@Model.CurrentPage"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
