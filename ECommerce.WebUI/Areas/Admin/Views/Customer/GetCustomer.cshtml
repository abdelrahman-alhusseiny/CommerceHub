@model CustomerVM

@{
	ViewData["Title"] = "Customer Profile";
}

<div class="container mt-4">
	<div class="text-center mb-4">
		<img src="@Model.DisplayImageUrl" alt="Customer Image"
			 class="rounded-circle shadow-sm mb-3"
			 style="width:200px; height:200px; object-fit:cover;" />
		<h2 class="fw-bold">
			<i class="bi bi-person-circle"></i> @Model.Customer.FullName
		</h2>
	</div>

	<div class="card shadow-sm">
		<div class="card-body">
			<dl class="row">
				<dt class="col-sm-4"><i class="bi bi-envelope"></i> Email</dt>
				<dd class="col-sm-8">@Model.AppUserEmail</dd>

				<dt class="col-sm-4"><i class="bi bi-telephone"></i> Phone Number</dt>
				<dd class="col-sm-8">@Model.Customer.PhoneNumber</dd>

				<dt class="col-sm-4"><i class="bi bi-geo-alt"></i> Address</dt>
				<dd class="col-sm-8">@Model.Customer.Address</dd>

				<dt class="col-sm-4"><i class="bi bi-gender-ambiguous"></i> Gender</dt>
				<dd class="col-sm-8">@Model.Customer.Gender</dd>

				<dt class="col-sm-4"><i class="bi bi-calendar"></i> Date of Birth</dt>
				<dd class="col-sm-8">@Model.Customer.DateOfBirth.ToString("yyyy-MM-dd")</dd>

				<dt class="col-sm-4"><i class="bi bi-lock"></i> Lockout Status</dt>
				<dd class="col-sm-8">@Model.AppUserLockoutStatus</dd>

				<dt class="col-sm-4"><i class="bi bi-clock-history"></i> Account Created On</dt>
				<dd class="col-sm-8">@Model.Customer.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
			</dl>
		</div>

		<div class="card-footer text-end">
			<a asp-area="Admin" asp-controller="Customer" asp-action="GetAllCustomers"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-lockoutStatus="@Model.LockoutStatus"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-secondary me-2">
				<i class="bi bi-arrow-left-circle"></i> Back to List
			</a>
			<a asp-area="Admin" asp-controller="Customer" asp-action="EditCustomer"
			   asp-route-id="@Model.Customer.Id"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-lockoutStatus="@Model.LockoutStatus"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-warning me-2">
				<i class="bi bi-pencil-square"></i> Edit Profile
			</a>
			<form asp-area="Admin" asp-controller="Customer" asp-action="ToggleCustomerLock" method="post" class="d-inline">
				@Html.AntiForgeryToken()

				<input asp-for="Customer.Id" type="hidden" />
				<input asp-for="SourceView" type="hidden" />
				<input asp-for="SearchString" type="hidden" />
				<input asp-for="LockoutStatus" type="hidden" />
				<input asp-for="CurrentSort" type="hidden" />
				<input asp-for="CurrentPage" type="hidden" />

				@if (Model.AppUserLockoutStatus == "Locked")
				{
					<button type="submit" class="btn btn-success">
						<i class="bi bi-unlock-fill"></i> Unlock
					</button>
				}
				else
				{
					<button type="submit" class="btn btn-secondary">
						<i class="bi bi-lock-fill"></i> Lock
					</button>
				}
			</form>
			<a asp-area="Admin" asp-controller="Customer" asp-action="ResetCustomerPassword"
			   asp-route-id="@Model.Customer.Id"
			   asp-route-sourceView="@Model.SourceView"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-lockoutStatus="@Model.LockoutStatus"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-primary me-2">
				<i class="bi bi-key"></i> Reset Password
			</a>
			<a asp-area="Admin" asp-controller="Customer" asp-action="DeleteCustomer"
			   asp-route-id="@Model.Customer.Id"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-lockoutStatus="@Model.LockoutStatus"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-danger">
				<i class="bi bi-trash"></i> Delete Account
			</a>
		</div>
	</div>
</div>
