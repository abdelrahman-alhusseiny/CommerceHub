@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-speedometer2"></i>
            Admin Dashboard
        </h1>

        <p class="text-muted">
            Manage every aspect of CommerceHub from one place.
        </p>
    </div>

    <div class="row g-4">

        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="col-md-4">
                <a asp-area="Admin"
                   asp-controller="Admin"
                   asp-action="GetAllAdmins"
                   class="text-decoration-none">

                    <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                        <div class="card-body">
                            <i class="bi bi-shield-lock display-1 text-primary"></i>

                            <h3 class="mt-3">
                                Admins
                            </h3>

                            <p class="text-muted">
                                Manage administrators and permissions.
                            </p>
                        </div>

                    </div>

                </a>
            </div>
        }

        <div class="col-md-4">
            <a asp-area="Admin"
               asp-controller="Customer"
               asp-action="GetAllCustomers"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                    <div class="card-body">

                        <i class="bi bi-people-fill display-1 text-success"></i>

                        <h3 class="mt-3">
                            Customers
                        </h3>

                        <p class="text-muted">
                            View and manage platform customers.
                        </p>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin"
               asp-controller="Vendor"
               asp-action="GetAllVendors"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                    <div class="card-body">

                        <i class="bi bi-shop display-1 text-warning"></i>

                        <h3 class="mt-3">
                            Vendors
                        </h3>

                        <p class="text-muted">
                            Manage sellers and stores.
                        </p>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin"
               asp-controller="Category"
               asp-action="GetAllCategories"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                    <div class="card-body">

                        <i class="bi bi-list-ul display-1 text-danger"></i>

                        <h3 class="mt-3">
                            Categories
                        </h3>

                        <p class="text-muted">
                            Organize products by categories.
                        </p>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="GetAllProducts"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                    <div class="card-body">

                        <i class="bi bi-box-seam display-1 text-info"></i>

                        <h3 class="mt-3">
                            Products
                        </h3>

                        <p class="text-muted">
                            Manage all products in the marketplace.
                        </p>

                    </div>

                </div>

            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="GetAllOrders"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 h-100 text-center dashboard-card">

                    <div class="card-body">

                        <i class="bi bi-cart-check display-1 text-dark"></i>

                        <h3 class="mt-3">
                            Orders
                        </h3>

                        <p class="text-muted">
                            Track and manage customer orders.
                        </p>

                    </div>

                </div>

            </a>
        </div>

    </div>

</div>