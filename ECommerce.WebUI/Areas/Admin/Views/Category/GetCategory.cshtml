@model CategoryVM

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-img-top text-center">
            <img src="@Model.DisplayImageUrl" alt="Category Image"
                 class="img-fluid shadow-sm"
                 style="max-height:300px; width:100%; object-fit:cover;" />
        </div>

        <div class="card-body">
            <h2 class="fw-bold mb-3">
                <i class="bi bi-tags"></i> @Model.Category.Name
            </h2>

            <dl class="row">
                <dt class="col-sm-3"><i class="bi bi-card-text"></i> Description</dt>
                <dd class="col-sm-9">@Model.Category.Description</dd>

                <dt class="col-sm-3"><i class="bi bi-clock-history"></i> Created On</dt>
                <dd class="col-sm-9">@Model.Category.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>

        <div class="card-footer text-end">
            <a asp-area="Admin" asp-controller="Category" asp-action="GetAllCategories"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="EditCategory"
               asp-route-id="@Model.Category.Id"
               asp-route-sourceView="@Model.SourceView"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i> Edit Category
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="DeleteCategory"
               asp-route-id="@Model.Category.Id"
               asp-route-sourceView="@Model.SourceView"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete Category
            </a>
        </div>
    </div>
</div>
