@model CategoryVM

@{
	ViewData["Title"] = "Create Category";
}

<div class="container py-4">
	<h2 class="mb-4">
		<i class="bi bi-person-plus"></i> Create New Category
	</h2>

	<form asp-area="Admin" asp-controller="Category" asp-action="CreateCategory"
		  method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
		@Html.AntiForgeryToken()
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<input asp-for="SearchString" type="hidden" />
		<input asp-for="CurrentSort" type="hidden" />
		<input asp-for="CurrentPage" type="hidden" />

		<div class="mb-3">
			<label asp-for="Category.Name" class="form-label">
				<i class="bi bi-tag"></i> Name
			</label>
			<input asp-for="Category.Name" class="form-control" />
			<span asp-validation-for="Category.Name" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Category.Description" class="form-label">
				<i class="bi bi-info-circle"></i> Description
			</label>
			<input asp-for="Category.Description" class="form-control" />
			<span asp-validation-for="Category.Description" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Category.ImageFile" class="form-label">
				<i class="bi bi-image"></i> Image (Optional)
			</label>
			<input asp-for="Category.ImageFile" type="file" class="form-control"
				   accept="image/*" />
			<span asp-validation-for="Category.ImageFile" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-between mt-4">
			<button type="submit" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Save
			</button>
			<a asp-area="Admin" asp-controller="Category" asp-action="GetAllCategories"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-secondary">
				<i class="bi bi-arrow-left-circle"></i> Back to List
			</a>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
