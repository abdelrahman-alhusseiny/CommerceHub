@model ProductListVM

@{
	ViewData["Title"] = "Product List";
}

<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>
			<i class="bi bi-box-seam"></i> Product List
		</h2>
	</div>

	<form asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts" method="get"
		  class="row g-2 mb-3">
		<input type="hidden" name="currentSort" value="@Model.CurrentSort" />
		<input type="hidden" name="currentPage" value="1" />

		<div class="col-md-4">
			<input type="text"
				   name="searchString"
				   value="@Model.SearchString"
				   class="form-control"
				   placeholder="Search products..." />
		</div>

		<div class="col-md-3">
			<select name="categoryId"
					asp-items="Model.CategoryList"
					class="form-select"
					onchange="this.form.submit()">
				<option value="">All Categories</option>
			</select>
		</div>

		<div class="col-md-2 d-flex">
			<a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
			   class="btn btn-outline-secondary">
				<i class="bi bi-arrow-counterclockwise"></i> Reset
			</a>
		</div>
	</form>

	<div class="mb-3">
		<span class="me-2 fw-bold">Sort by:</span>
		<a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
		   asp-route-currentSort="@Model.NameSort"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-categoryId="@Model.CategoryId"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-sm btn-outline-secondary me-1">
			Name
			@if (Model.CurrentSort == "name")
			{
				<i class="bi bi-caret-up-fill"></i>
			}
			else if (Model.CurrentSort == "name_desc")
			{
				<i class="bi bi-caret-down-fill"></i>
			}
		</a>

		<a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
		   asp-route-currentSort="@Model.PriceSort"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-categoryId="@Model.CategoryId"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-sm btn-outline-secondary">
			Price
			@if (Model.CurrentSort == "price")
			{
				<i class="bi bi-caret-up-fill"></i>
			}
			else if (Model.CurrentSort == "price_desc")
			{
				<i class="bi bi-caret-down-fill"></i>
			}
		</a>
	</div>

	@if (!Model.Products.Any())
	{
		<div class="alert alert-warning">
			<i class="bi bi-exclamation-triangle"></i> No products available.
		</div>
	}
	else
	{
		<div class="row">
			@foreach (var item in Model.Products)
			{
				<div class="col-md-4 mb-4">
					<div class="card h-100 shadow-sm">
						<a asp-area="Customer" asp-controller="Shop" asp-action="GetProduct" asp-route-id="@item.Product.Id"
						   asp-route-searchString="@Model.SearchString"
						   asp-route-categoryId="@Model.CategoryId"
						   asp-route-currentSort="@Model.CurrentSort"
						   asp-route-currentPage="@Model.CurrentPage">
							<img src="@item.DisplayImageUrl"
								 class="card-img-top"
								 alt="Product Image"
								 style="height:250px; object-fit:cover;" />
						</a>
						<div class="card-body">
							<h5 class="card-title">@item.Product.Name</h5>
							<p class="card-text">
								<span class="fw-bold text-success">@item.DisplayPrice</span><br />
								<span class="text-muted text-decoration-line-through">@item.DisplayOldPrice</span>
							</p>
							<p class="card-text">
								<small class="text-muted">Category: @item.CategoryName</small><br />
								<small class="text-muted">Quantity: @item.Product.Quantity</small>
							</p>
						</div>
					</div>
				</div>
			}
		</div>

		<nav aria-label="Page navigation">
			<ul class="pagination justify-content-between">
				@if (Model.CurrentPage > 1)
				{
					<li class="page-item">
						<a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
						   asp-route-currentPage="@(Model.CurrentPage - 1)"
						   asp-route-searchString="@Model.SearchString"
						   asp-route-categoryId="@Model.CategoryId"
						   asp-route-currentSort="@Model.CurrentSort"
						   class="page-link">
							Previous
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Previous</span>
					</li>
				}

				<li class="page-item flex-grow-1 d-flex justify-content-center">
					<ul class="pagination mb-0">
						@for (int i = 1; i <= Model.TotalPages; i++)
						{
							<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
								<a asp-area="Customer" asp-controller="Shop"
								   asp-action="GetAllProducts"
								   asp-route-currentPage="@i"
								   asp-route-searchString="@Model.SearchString"
								   asp-route-categoryId="@Model.CategoryId"
								   asp-route-currentSort="@Model.CurrentSort"
								   class="page-link">
									@i
								</a>
							</li>
						}
					</ul>
				</li>

				@if (Model.CurrentPage < Model.TotalPages)
				{
					<li class="page-item">
						<a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
						   asp-route-currentPage="@(Model.CurrentPage + 1)"
						   asp-route-searchString="@Model.SearchString"
						   asp-route-categoryId="@Model.CategoryId"
						   asp-route-currentSort="@Model.CurrentSort"
						   class="page-link">
							Next
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Next</span>
					</li>
				}
			</ul>
		</nav>
	}
</div>
