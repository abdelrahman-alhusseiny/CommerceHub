@model OrderHeaderListVM

@{
	ViewData["Title"] = "Order List";
}

<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>
			<i class="bi bi-box-seam"></i> Order List
		</h2>
	</div>

	<form asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders" method="get"
		  class="row g-2 mb-3">
		<input type="hidden" name="currentSort" value="@Model.CurrentSort" />
		<input type="hidden" name="currentPage" value="1" />

		<div class="col-md-4">
			<input type="text"
				   name="searchString"
				   value="@Model.SearchString"
				   class="form-control"
				   placeholder="Search orders..." />
		</div>

		<div class="col-md-3">
			<select name="orderStatus"
					asp-items="Model.OrderStatusList"
					class="form-select"
					onchange="this.form.submit()">
				<option value="">All Statuses</option>
			</select>
		</div>

		<div class="col-md-2 d-flex">
			<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
			   class="btn btn-outline-secondary">
				<i class="bi bi-arrow-counterclockwise"></i> Reset
			</a>
		</div>
	</form>

	<div class="mb-3">
		<span class="me-2 fw-bold">Sort by:</span>
		<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
		   asp-route-currentSort="@Model.NameSort"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-orderStatus="@Model.OrderStatus"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-sm btn-outline-secondary me-1">
			Name
			@if (Model.CurrentSort == "name")
			{
				<i class="bi bi-caret-up-fill"></i>
			}
			else if (Model.CurrentSort == "name_desc")
			{
				<i class="bi bi-caret-down-fill"></i>
			}
		</a>

		<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
		   asp-route-currentSort="@Model.TotalCostSort"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-orderStatus="@Model.OrderStatus"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-sm btn-outline-secondary">
			Total Cost
			@if (Model.CurrentSort == "totalCost")
			{
				<i class="bi bi-caret-up-fill"></i>
			}
			else if (Model.CurrentSort == "totalCost_desc")
			{
				<i class="bi bi-caret-down-fill"></i>
			}
		</a>

		<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
		   asp-route-currentSort="@Model.OrderDateSort"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-orderStatus="@Model.OrderStatus"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-sm btn-outline-secondary">
			Order Date
			@if (Model.CurrentSort == "orderDate")
			{
				<i class="bi bi-caret-up-fill"></i>
			}
			else if (Model.CurrentSort == "orderDate_desc")
			{
				<i class="bi bi-caret-down-fill"></i>
			}
		</a>
	</div>

	@if (!Model.OrderHeaders.Any())
	{
		<div class="alert alert-warning">
			<i class="bi bi-exclamation-triangle"></i> No orders available.
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-hover table-bordered align-middle">
				<thead class="table-dark">
					<tr>
						<th><i class="bi bi-person"></i> Full Name</th>
						<th><i class="bi bi-envelope"></i> Email</th>
						<th><i class="bi bi-telephone"></i> Phone Number</th>
						<th><i class="bi bi-currency-dollar"></i> Total Cost</th>
						<th><i class="bi bi-calendar-date"></i> Order Date</th>
						<th><i class="bi bi-check2-circle"></i> Order Status</th>
						<th><i class="bi bi-gear"></i> Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.OrderHeaders)
					{
						<tr>
							<td>@item.OrderHeader.FullName</td>
							<td>@item.OrderHeader.Email</td>
							<td>@item.OrderHeader.PhoneNumber</td>
							<td>@item.DisplayTotalCost</td>
							<td>@item.OrderHeader.OrderDate.ToString("yyyy-MM-dd")</td>
							<td>@item.OrderHeader.OrderStatus</td>
							<td>
								<a asp-area="Customer" asp-controller="Order"
								   asp-action="GetOrder" asp-route-id="@item.OrderHeader.Id"
								   asp-route-searchString="@Model.SearchString"
								   asp-route-orderStatus="@Model.OrderStatus"
								   asp-route-currentSort="@Model.CurrentSort"
								   asp-route-currentPage="@Model.CurrentPage"
								   class="btn btn-sm btn-info me-1">
									<i class="bi bi-eye"></i> Details
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<nav aria-label="Page navigation">
			<ul class="pagination justify-content-between">
				@if (Model.CurrentPage > 1)
				{
					<li class="page-item">
						<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
						   asp-route-currentPage="@(Model.CurrentPage - 1)"
						   asp-route-searchString="@Model.SearchString"
						   asp-route-orderStatus="@Model.OrderStatus"
						   asp-route-currentSort="@Model.CurrentSort"
						   class="page-link">
							Previous
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Previous</span>
					</li>
				}

				<li class="page-item flex-grow-1 d-flex justify-content-center">
					<ul class="pagination mb-0">
						@for (int i = 1; i <= Model.TotalPages; i++)
						{
							<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
								<a asp-area="Customer" asp-controller="Order"
								   asp-action="GetAllOrders"
								   asp-route-currentPage="@i"
								   asp-route-searchString="@Model.SearchString"
								   asp-route-orderStatus="@Model.OrderStatus"
								   asp-route-currentSort="@Model.CurrentSort"
								   class="page-link">
									@i
								</a>
							</li>
						}
					</ul>
				</li>

				@if (Model.CurrentPage < Model.TotalPages)
				{
					<li class="page-item">
						<a asp-area="Customer" asp-controller="Order" asp-action="GetAllOrders"
						   asp-route-currentPage="@(Model.CurrentPage + 1)"
						   asp-route-searchString="@Model.SearchString"
						   asp-route-orderStatus="@Model.OrderStatus"
						   asp-route-currentSort="@Model.CurrentSort"
						   class="page-link">
							Next
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Next</span>
					</li>
				}
			</ul>
		</nav>
	}
</div>
