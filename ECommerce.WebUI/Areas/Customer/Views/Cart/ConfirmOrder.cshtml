@model int

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
    </div>

    <h2 class="fw-bold">Order Confirmed!</h2>
    <p class="text-muted">Thank you for your purchase. We're preparing your order.</p>

    <h4 class="mt-3">Order Number: <span class="text-success">@Model</span></h4>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a asp-area="Customer" asp-controller="Order" asp-action="Index"
           class="btn btn-success">
            View My Orders
        </a>
        <a asp-area="Customer" asp-controller="Shop" asp-action="GetAllProducts"
           class="btn btn-outline-secondary">
            Continue Shopping
        </a>
    </div>
</div>
