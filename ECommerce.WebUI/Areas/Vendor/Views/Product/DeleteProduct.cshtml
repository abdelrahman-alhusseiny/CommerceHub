@model ProductVM

@{
	ViewData["Title"] = "Delete Product";
}

<div class="container py-4">
	<h2 class="mb-4 text-danger">
		<i class="bi bi-trash"></i> Delete Product
	</h2>

	<div class="alert alert-danger d-flex align-items-center" role="alert">
		<i class="bi bi-exclamation-triangle-fill me-2"></i>
		<div>
			Are you sure you want to delete this product? This action cannot be undone.
		</div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-body">
			<dl class="row">
				<dt class="col-sm-3"><i class="bi bi-image"></i> Product Images</dt>
				<dd class="col-sm-9">
					<div class="d-flex flex-wrap gap-3">
						@foreach (var img in Model.ProductImageUrls)
						{
							<img src="@img" alt="Product Image"
								 class="img-thumbnail"
								 style="width:120px; height:auto;" />
						}
					</div>
				</dd>

				<dt class="col-sm-3"><i class="bi bi-tag"></i> Name</dt>
				<dd class="col-sm-9">@Model.Product.Name</dd>

				<dt class="col-sm-3"><i class="bi bi-card-text"></i> Description</dt>
				<dd class="col-sm-9">@Model.Product.Description</dd>

				<dt class="col-sm-3"><i class="bi bi-book"></i> ISBN</dt>
				<dd class="col-sm-9">@Model.Product.ISBN</dd>

				<dt class="col-sm-3"><i class="bi bi-currency-dollar"></i> Price</dt>
				<dd class="col-sm-9">@Model.DisplayPrice</dd>

				<dt class="col-sm-3"><i class="bi bi-currency-exchange"></i> Old Price</dt>
				<dd class="col-sm-9">@Model.DisplayOldPrice</dd>

				<dt class="col-sm-3"><i class="bi bi-box-seam"></i> Quantity</dt>
				<dd class="col-sm-9">@Model.Product.Quantity</dd>

				<dt class="col-sm-3"><i class="bi bi-list"></i> Category</dt>
				<dd class="col-sm-9">@Model.CategoryName</dd>

				<dt class="col-sm-3"><i class="bi bi-clock-history"></i> Created On</dt>
				<dd class="col-sm-9">@Model.Product.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
			</dl>
		</div>
	</div>

	<form asp-area="Vendor" asp-controller="Product" asp-action="DeleteProduct" method="post"
		  class="d-flex gap-2">
		<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

		<input asp-for="Product.Id" type="hidden" />

		<input asp-for="SearchString" type="hidden" />
		<input asp-for="CategoryId" type="hidden" />
		<input asp-for="CurrentSort" type="hidden" />
		<input asp-for="CurrentPage" type="hidden" />

		<button type="submit" class="btn btn-danger">
			<i class="bi bi-trash-fill"></i> Yes, Delete
		</button>
		<a asp-area="Vendor" asp-controller="Product" asp-action="@Model.SourceView"
		   asp-route-id="@Model.Product.Id"
		   asp-route-searchString="@Model.SearchString"
		   asp-route-categoryId="@Model.CategoryId"
		   asp-route-currentSort="@Model.CurrentSort"
		   asp-route-currentPage="@Model.CurrentPage"
		   class="btn btn-secondary">
			<i class="bi bi-x-circle"></i> Cancel
		</a>
	</form>
</div>