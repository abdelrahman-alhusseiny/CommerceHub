@model ProductVM

@{
	ViewData["Title"] = "Edit Product";
}

<div class="container py-4">
	<h2 class="mb-4">
		<i class="bi bi-pencil-square"></i> Edit Product
	</h2>

	<form asp-area="Vendor" asp-controller="Product" asp-action="EditProduct" method="post"
		  enctype="multipart/form-data" class="card shadow-sm p-4">
		@Html.AntiForgeryToken()

		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<input asp-for="Product.Id" type="hidden" />
		<input asp-for="Product.ProductImages" type="hidden" />

		@for (int i = 0; i < Model.ProductImagePairs.Count; i++)
		{
			<input type="hidden" asp-for="ProductImagePairs[@i].ImageId" />
			<input type="hidden" asp-for="ProductImagePairs[@i].ImageUrl" />
		}
		<input asp-for="HasCustomImage" type="hidden" />

		<input asp-for="SourceView" type="hidden" />
		<input asp-for="SearchString" type="hidden" />
		<input asp-for="CategoryId" type="hidden" />
		<input asp-for="CurrentSort" type="hidden" />
		<input asp-for="CurrentPage" type="hidden" />

		<div class="mb-3">
			<label class="form-label">
				<i class="bi bi-image"></i> Current Images
			</label>

			<div class="d-flex flex-wrap gap-3">
				@foreach (var img in Model.ProductImagePairs)
				{
					<div class="text-center">
						<img src="@img.ImageUrl"
							 alt="Product Image"
							 class="img-thumbnail"
							 style="width:120px; height:auto;" />

						@if (Model.HasCustomImage)
						{
							<div class="form-check">
								<input type="checkbox" name="ProductImageIds" value="@img.ImageId"
								class="form-check-input" />
								<label class="form-check-label">Delete</label>
							</div>
						}
					</div>
				}
			</div>

			@if (Model.HasCustomImage)
			{
				<button type="submit" asp-area="Vendor" asp-controller="Product"
						asp-action="DeleteProductImage" class="btn btn-danger mt-3">
					<i class="bi bi-trash"></i> Delete Selected Images
				</button>
			}
		</div>

		<div class="mb-3">
			<label asp-for="Product.Name" class="form-label">
				<i class="bi bi-tag"></i> Product Name
			</label>
			<input asp-for="Product.Name" class="form-control" />
			<span asp-validation-for="Product.Name" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Description" class="form-label">
				<i class="bi bi-card-text"></i> Product Description
			</label>
			<textarea asp-for="Product.Description" class="form-control"></textarea>
			<span asp-validation-for="Product.Description" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.ISBN" class="form-label">
				<i class="bi bi-book"></i> Product ISBN
			</label>
			<input asp-for="Product.ISBN" class="form-control" />
			<span asp-validation-for="Product.ISBN" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Price" class="form-label">
				<i class="bi bi-currency-dollar"></i> Product Price
			</label>
			<input asp-for="Product.Price" class="form-control" step="0.01" />
			<span asp-validation-for="Product.Price" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.OldPrice" class="form-label">
				<i class="bi bi-currency-exchange"></i> Product Old Price (Optional)
			</label>
			<input asp-for="Product.OldPrice" class="form-control" />
			<span asp-validation-for="Product.OldPrice" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Quantity" class="form-label">
				<i class="bi bi-box-seam"></i> Product Quantity
			</label>
			<input asp-for="Product.Quantity" class="form-control" />
			<span asp-validation-for="Product.Quantity" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.CategoryId" class="form-label">
				<i class="bi bi-list"></i> Product Category
			</label>
			<select asp-for="Product.CategoryId" asp-items="Model.CategoryList"
					class="form-select">
				<option value="">-- Select Category --</option>
			</select>
			<span asp-validation-for="Product.CategoryId" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="ImageFiles" class="form-label">
				<i class="bi bi-image"></i> Add New Images (Optional)
			</label>
			<input type="file" name="ImageFiles" multiple accept="image/*"
				   class="form-control" />
			<span asp-validation-for="ImageFiles" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-between mt-4">
			<button type="submit" class="btn btn-warning">
				<i class="bi bi-save"></i> Save Changes
			</button>
			<a asp-area="Vendor" asp-controller="Product" asp-action="@Model.SourceView"
			   asp-route-id="@Model.Product.Id"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-categoryId="@Model.CategoryId"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-secondary">
				<i class="bi bi-x-circle"></i> Cancel
			</a>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
