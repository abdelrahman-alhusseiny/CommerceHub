@model ProductVM

@{
	ViewData["Title"] = "Create Product";
}


<div class="container py-4">
	<h2 class="mb-4">
		<i class="bi bi-plus-circle"></i> Create Product
	</h2>

	<form asp-area="Vendor" asp-controller="Product" asp-action="CreateProduct" method="post"
		  enctype="multipart/form-data" class="card shadow-sm p-4">
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<input asp-for="SearchString" type="hidden" />
		<input asp-for="CategoryId" type="hidden" />
		<input asp-for="CurrentSort" type="hidden" />
		<input asp-for="CurrentPage" type="hidden" />

		<div class="mb-3">
			<label asp-for="Product.Name" class="form-label">
				<i class="bi bi-tag"></i> Product Name
			</label>
			<input asp-for="Product.Name" class="form-control" />
			<span asp-validation-for="Product.Name" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Description" class="form-label">
				<i class="bi bi-card-text"></i> Product Description
			</label>
			<textarea asp-for="Product.Description" class="form-control"></textarea>
			<span asp-validation-for="Product.Description" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.ISBN" class="form-label">
				<i class="bi bi-book"></i> Product ISBN
			</label>
			<input asp-for="Product.ISBN" class="form-control" />
			<span asp-validation-for="Product.ISBN" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Price" class="form-label">
				<i class="bi bi-currency-dollar"></i> Product Price
			</label>
			<input asp-for="Product.Price" class="form-control" />
			<span asp-validation-for="Product.Price" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.OldPrice" class="form-label">
				<i class="bi bi-currency-exchange"></i> Product Old Price (Optional)
			</label>
			<input asp-for="Product.OldPrice" class="form-control" />
			<span asp-validation-for="Product.OldPrice" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.Quantity" class="form-label">
				<i class="bi bi-box-seam"></i> Product Quantity
			</label>
			<input asp-for="Product.Quantity" class="form-control" />
			<span asp-validation-for="Product.Quantity" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Product.CategoryId" class="form-label">
				<i class="bi bi-list"></i> Product Category
			</label>
			<select asp-for="Product.CategoryId" asp-items="Model.CategoryList"
					class="form-select">
				<option value="">-- Select Category --</option>
			</select>
			<span asp-validation-for="Product.CategoryId" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="ImageFiles" class="form-label">
				<i class="bi bi-image"></i> Product Images (Optional)
			</label>
			<input type="file" name="ImageFiles" multiple accept="image/*"
				   class="form-control" />
			<span asp-validation-for="ImageFiles" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-between mt-4">
			<button type="submit" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Save
			</button>
			<a asp-area="Vendor" asp-controller="Product" asp-action="GetAllProducts"
			   asp-route-searchString="@Model.SearchString"
			   asp-route-categoryId="@Model.CategoryId"
			   asp-route-currentSort="@Model.CurrentSort"
			   asp-route-currentPage="@Model.CurrentPage"
			   class="btn btn-secondary">
				<i class="bi bi-arrow-left-circle"></i> Back
			</a>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
