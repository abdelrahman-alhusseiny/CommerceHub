@model VendorVM

@{
	ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">
	<h2 class="mb-4"><i class="bi bi-pencil-square"></i> Edit Profile</h2>

	<form asp-area="Vendor" asp-controller="Profile" asp-action="EditProfile" method="post"
		  enctype="multipart/form-data">
		@Html.AntiForgeryToken()
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<input asp-for="Vendor.Id" type="hidden" />
		<input asp-for="Vendor.ImageUrl" type="hidden" />
		<input asp-for="DisplayImageUrl" type="hidden" /> 
		<input asp-for="HasCustomImage" type="hidden" /> 

		<div class="row">
			<div class="col-md-4 text-center">
				<img src="@Model.DisplayImageUrl" alt="Vendor Image"
					 class="rounded-circle shadow-sm mb-3"
					 style="width:200px; height:200px; object-fit:cover;" />
				@if (Model.HasCustomImage)
				{
					<div class="mt-2">
						<button type="submit" asp-area="Vendor" asp-controller="Profile"
								asp-action="DeleteProfileImage" class="btn btn-outline-danger btn-sm">
							<i class="bi bi-trash"></i> Remove Image
						</button>
					</div>
				}

				<div class="mt-3">
					<label asp-for="Vendor.ImageFile" class="form-label">
						<i class="bi bi-upload"></i> Upload New Image
					</label>
					<input asp-for="Vendor.ImageFile" type="file" class="form-control" />
					<span asp-validation-for="Vendor.ImageFile" class="text-danger">
					</span>
				</div>
			</div>

			<div class="col-md-8">
				<div class="mb-3">
					<label asp-for="Vendor.StoreName" class="form-label">
						<i class="bi bi-shop"></i> Store Name
					</label>
					<input asp-for="Vendor.StoreName" class="form-control" />
					<span asp-validation-for="Vendor.StoreName" class="text-danger">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Vendor.OwnerFullName" class="form-label">
						<i class="bi bi-person"></i> Owner Full Name
					</label>
					<input asp-for="Vendor.OwnerFullName" class="form-control" />
					<span asp-validation-for="Vendor.OwnerFullName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Vendor.PhoneNumber" class="form-label">
						<i class="bi bi-telephone"></i> Phone Number
					</label>
					<input asp-for="Vendor.PhoneNumber" class="form-control" />
					<span asp-validation-for="Vendor.PhoneNumber" class="text-danger">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Vendor.StoreAddress" class="form-label">
						<i class="bi bi-geo-alt"></i> Store Address
					</label>
					<input asp-for="Vendor.StoreAddress" class="form-control" />
					<span asp-validation-for="Vendor.StoreAddress" class="text-danger">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Vendor.StoreDescription" class="form-label">
						<i class="bi bi-card-text"></i> Store Description
					</label>
					<textarea asp-for="Vendor.StoreDescription" class="form-control"
							  rows="4"></textarea>
					<span asp-validation-for="Vendor.StoreDescription"
						  class="text-danger"></span>
				</div>
			</div>

			<div class="mt-4 text-end">
				<button type="submit" class="btn btn-success">
					<i class="bi bi-check-circle"></i> Save Changes
				</button>
				<a asp-area="Vendor" asp-controller="Profile" asp-action="GetProfile"
				   class="btn btn-secondary">
					<i class="bi bi-arrow-left-circle"></i> Cancel
				</a>
			</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
