@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container">

    <div class="text-center mb-5">

        <i class="bi bi-shield-lock display-1 text-primary"></i>

        <h1 class="display-4 fw-bold mt-3">
            Privacy Policy
        </h1>

        <p class="lead text-muted">
            Your privacy and security are important to us.
        </p>

    </div>


    <div class="card shadow border-0">

        <div class="card-body p-5">

            <h3>
                Information We Collect
            </h3>

            <p class="text-muted">
                CommerceHub may collect personal information such as your name,
                email address, and account details when registering or using our platform.
            </p>

            <hr />

            <h3>
                How We Use Your Information
            </h3>

            <p class="text-muted">
                The information collected is used to manage accounts,
                process orders, improve user experience,
                and maintain platform security.
            </p>

            <hr />

            <h3>
                Data Protection
            </h3>

            <p class="text-muted">
                We take reasonable measures to protect user information
                and prevent unauthorized access to personal data.
            </p>

            <hr />

            <h3>
                Cookies
            </h3>

            <p class="text-muted">
                Cookies may be used to improve website functionality
                and enhance the user experience.
            </p>

            <hr />

            <h3>
                Third-Party Services
            </h3>

            <p class="text-muted">
                CommerceHub may use third-party services for authentication,
                analytics, or payment processing. These services have their own privacy policies.
            </p>

            <hr />

            <h3>
                User Rights
            </h3>

            <p class="text-muted">
                Users may update, modify, or delete their account information
                through the profile management section when applicable.
            </p>

        </div>

    </div>

</div>